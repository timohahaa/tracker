DEBUG=true
HTTP_ADDR=:8080
POSTGRES_DSN=postgres://postgres:password@localhost:5432/tracker?sslmode=disable
MIGRATIONS_PATH=migrations/sql
SESSION_TTL=720h
# Имя cookie web-сессии (необязательное, по умолчанию session_id)
SESSION_COOKIE_NAME=session_id
# Пул соединений с БД (необязательные, значения по умолчанию ниже)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
# DSN тестовой БД для integration-тестов
TEST_POSTGRES_DSN=postgres://postgres:password@localhost:5432/tracker?sslmode=disable
